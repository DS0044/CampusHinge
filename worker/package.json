{
  "name": "campushinge-worker",
  "version": "1.0.0",
  "description": "CampusHinge API — Cloudflare Workers backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 execute campushinge-db --local --file=migrations/0001_initial.sql",
    "migrate:remote": "wrangler d1 execute campushinge-db --remote --file=migrations/0001_initial.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
