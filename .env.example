# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database ──
DATABASE_URL=postgresql://campusapp:campusapp_dev@localhost:5432/campusapp

# ── JWT ──
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# ── Email (Nodemailer / SES) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── Allowed Email Domains (comma-separated) ──
ALLOWED_EMAIL_DOMAINS=vitbhopal.ac.in

# ── Allowed Extra Emails (comma-separated exact emails bypassing domain check) ──
ALLOWED_EXTRA_EMAILS=ideepaksingh44@gmail.com

# ── AWS S3 ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=campusapp-uploads
S3_PRESIGNED_URL_EXPIRY=300

# ── Razorpay ──
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PLAN_ID=your_razorpay_plan_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Subscription ──
SUBSCRIPTION_DURATION_DAYS=35
