{
  "name": "campushinge-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHinge — NestJS + Fastify Modular Monolith Backend",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "dev": "node --watch --watch-path=src dist/main.js",
    "dev:watch": "tsc -w -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-fastify": "^10.4.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.8",
    "drizzle-kit": "^0.24.2",
    "ioredis-mock": "^8.9.0",
    "pg-mem": "^3.0.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
