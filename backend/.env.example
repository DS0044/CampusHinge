# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL 16) ──
DATABASE_URL=postgresql://campusapp:campusapp_dev@localhost:5432/campusapp

# ── Cache & Realtime State (Valkey / Redis) ──
VALKEY_URL=redis://localhost:6379

# ── JWT Secrets ──
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
