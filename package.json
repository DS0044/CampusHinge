{
  "name": "campushinge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHinge — Campus-verified dating & matching platform",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin-panel",
    "build": "npm run build --prefix frontend && npm run build --prefix admin-panel",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix admin-panel",
    "test": "npm test --prefix backend",
    "migrate": "npm run migrate --prefix backend",
    "db:clear": "npm run db:clear --prefix backend",
    "deploy:worker": "npm run deploy --prefix backend/worker",
    "db": "node scripts/db-users.js list",
    "users": "node scripts/db-users.js list",
    "users:delete": "node scripts/db-users.js delete"
  }
}
