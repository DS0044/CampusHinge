{
  "name": "campushinge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHinge — Campus-verified dating & matching platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin-panel",
    "start": "tsx src/index.ts",
    "build": "npm run build --prefix frontend && tsc",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix admin-panel",
    "build:backend": "tsc",
    "deploy:worker": "npm run deploy --prefix worker",
    "migrate": "tsx src/db/migrate.ts",
    "db": "tsx scripts/db-users.ts list",
    "users": "tsx scripts/db-users.ts list",
    "users:delete": "tsx scripts/db-users.ts delete",
    "db:clear": "tsx src/db/clear.ts",
    "test": "node --import tsx --test tests/auth.validator.test.js tests/pass_exclusion.test.js tests/resend_otp.test.js tests/super_like.test.js tests/terms.test.js tests/multi_intent.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
